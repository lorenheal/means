# Means — Makefile
CC      = gcc
CFLAGS  = -Wall -Wextra -Wuninitialized -O0 -ggdb -MMD -MP
LDFLAGS =

# generated by bison/flex
GEN     = means.tab.c means.tab.h means.lex.c

# hand-written sources
#SRCS    = ast.c exec.c builtins.c help.c symtab.c meanslist.c params.c mstring.c thing.c value.c
SRCS    =  ast.c builtins.c exec.c func.c help.c means.c meanslist.c \
			mstring.c params.c symlist.c symtab.c value.c
OBJS    = means.tab.o means.lex.o $(SRCS:.c=.o)

TARGET  = means

.PHONY: all clean

aLll: $(TARGET)

TESTS = test-mstring test-value test-print test-equal test-lists

test: $(TESTS) 

test-value: test-value.o value.o meanslist.o mstring.o help.o
	$(CC) -o $@ $^

test-mstring: test-mstring.o value.o meanslist.o mstring.o help.o
	$(CC) -o $@ $^

test-print: test-print.o value.o meanslist.o mstring.o help.o
	$(CC) -o $@ $^

test-equal: test-equal.o value.o meanslist.o mstring.o help.o
	$(CC) -o $@ $^

test-lists: test-lists.o meanslist.o value.o mstring.o help.o
	$(CC) -o $@ $^

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS) $(LDFLAGS)

# bison
means.tab.c means.tab.h: means.y
	bison -d -v -o means.tab.c means.y 

# flex (depends on the bison header for token definitions)
means.lex.c: means.l means.tab.h
	flex -o means.lex.c means.l

# ordinary .c → .o (automatic; header deps via -MMD)
%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.c: %.y

%.c: %.l


# include generated dependency files if they exist
-include $(OBJS:.o=.d)

clean:
	rm -f $(TARGET) $(OBJS) $(OBJS:.o=.d) $(GEN) means.output \
		  $(TESTS) $(addsuffix .o,$(TESTS)) $(addsuffix .d,$(TESTS))

backup:
	@read -p "Comment for backup: " comment; \
	stamp=$$(date +%Y%m%d-%H%M%S); \
	mkdir -p old; \
	echo "$$comment" > means-$${stamp}.txt; \
	tar cf old/means-$${stamp}.tar means.y means.l means-$${stamp}.txt \
		$(SRCS) $(addsuffix .c,$(TESTS)) Makefile DESIGN.md todo.md tests *.h ;  \
	echo "backed up to old/means-$${stamp}.tar ($$comment)"; \
	tar -tvf old/means-$${stamp}.tar ; \
	mv means-$${stamp}.txt old ; \
	ls -l old/means-$${stamp}.tar

.PHONY: all clean
